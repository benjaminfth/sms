# Environment Configuration
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms_dev?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET="brightloop-hackathon-access-secret-32-chars-long"
JWT_REFRESH_SECRET="brightloop-hackathon-refresh-secret-32-chars-long"
JWT_ISSUER="brightloop.sms"
JWT_AUDIENCE="brightloop.app"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY_DAYS=7

# Default Currency
DEFAULT_CURRENCY="INR"

# Email Delivery Configuration (Resend Transactional Email)
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="Brightloop SMS <noreply@your-verified-domain.com>"
# Fallback SMTP options if needed
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
