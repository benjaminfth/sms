# Environment Configuration
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms_dev?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET="brightloop-hackathon-access-secret-32-chars-long"
JWT_REFRESH_SECRET="brightloop-hackathon-refresh-secret-32-chars-long"
JWT_ISSUER="brightloop.sms"
JWT_AUDIENCE="brightloop.app"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY_DAYS=7

# Default Currency
DEFAULT_CURRENCY="INR"

# Email Delivery Configuration
# EMAIL_PROVIDER options: "logger" (dev terminal preview / memory test capture), "smtp" (live transmission)
EMAIL_PROVIDER="logger"
EMAIL_FROM="no-reply@brightloop.io"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
