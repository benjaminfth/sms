# PostgreSQL Connection (used by Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms_db?schema=public"

# Application Ports & Environment
PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# JWT Authentication Secrets
# (Generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET="dev-jwt-access-secret-replace-in-production-min-32-chars-long"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-replace-in-production-min-32-chars-long"

# Token Expiry Settings
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY_DAYS=7

# System Defaults
DEFAULT_CURRENCY="INR"

# Email Delivery Configuration
# EMAIL_PROVIDER options: "logger" (dev terminal preview / memory test capture), "smtp" (live transmission)
EMAIL_PROVIDER="smtp"
EMAIL_FROM="***"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="***"
SMTP_PASS="***"
